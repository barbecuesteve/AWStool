#!/usr/bin/env python3
"""awstool - stand up a new project from scratch.

Usage:
  awstool onboard [--dry-run] [--yes] [--name NAME] [--profile PROFILE]
                  [--with-repo] [--with-account] [--with-staging-account]
                  [--with-cdk] [--with-ci]

Run with no --with-* flags to be prompted for each step interactively.

Steps (each opt-in via flag or prompt):
  repo      git init (if needed), create GitHub repo under "barbecuesteve",
            add remote, push.
  account   Create an AWS Organizations OU named after the project and a
            "<name>-prod" account inside it; append a matching profile to
            ~/.aws/config (OrganizationAccountAccessRole via the management
            profile).
  staging   Also create a "<name>-staging" account and profile.
  cdk       cdk init an app in TypeScript or Python (prompted, or
            --cdk-language; init skipped if cdk.json exists), pin
            account/region per environment in a generated env module, and
            cdk bootstrap each new account.
  ci        GithubOidcStack (OIDC provider + GitHubDeployRole per account,
            deployed during onboarding) and a .github/workflows/deploy.yml
            stub: staging on push to main, prod on manual dispatch.

A quick-reference section of aws/gh/awsconsole/cdk commands is appended to
README.md before the initial push so it lands in the repo.

--dry-run runs read-only preflight checks and prints every command and file
it would write, without making changes.
"""

import argparse
import json
import re
import subprocess
import sys
import time
from pathlib import Path

GITHUB_OWNER = "barbecuesteve"
POLL_INTERVAL_SECONDS = 5
POLL_TIMEOUT_SECONDS = 300
AWS_CONFIG_PATH = Path.home() / ".aws" / "config"


# ---------------------------------------------------------------- utilities

def run(cmd, capture=True, check=True):
    """Run a command; return CompletedProcess."""
    return subprocess.run(
        cmd, capture_output=capture, text=True, check=check
    )


def run_json(cmd):
    return json.loads(run(cmd).stdout)


def shell_repr(cmd):
    def q(a):
        return f"'{a}'" if (" " in a or '"' in a) else a
    return " ".join(q(a) for a in cmd)


def die(msg):
    print(f"error: {msg}", file=sys.stderr)
    sys.exit(1)


def prompt(question, default=None):
    suffix = f" [{default}]" if default else ""
    answer = input(f"{question}{suffix}: ").strip()
    return answer or default or ""


def confirm(question, assume_yes=False):
    if assume_yes:
        print(f"{question} [y/N]: y (--yes)")
        return True
    return input(f"{question} [y/N]: ").strip().lower() in ("y", "yes")


class Plan:
    """Collects actions; prints them in dry-run, executes them otherwise."""

    def __init__(self, dry_run):
        self.dry_run = dry_run
        self._n = 0

    def execute(self, description, cmd=None, fn=None, detail=None):
        """cmd: a CLI command list. fn: a python callable (for composite
        steps like poll loops). detail: extra text to display (e.g. file
        content to be written). Returns CompletedProcess/fn result, or None
        in dry-run."""
        self._n += 1
        print(f"\n[{self._n}] {description}")
        if cmd is not None:
            print(f"    $ {shell_repr(cmd)}")
        if detail:
            for line in detail.rstrip("\n").splitlines():
                print(f"    | {line}")
        if self.dry_run:
            print("    (dry-run: skipped)")
            return None
        if fn is not None:
            return fn()
        return run(cmd, capture=False)


# ---------------------------------------------------------------- preflight

def check_binaries(binaries):
    for binary in binaries:
        if run(["which", binary], check=False).returncode != 0:
            die(f"required tool not found on PATH: {binary}")


def gh_preflight(name):
    auth = run(["gh", "auth", "status"], check=False)
    if auth.returncode != 0:
        die("gh is not authenticated; run: gh auth login")
    exists = run(
        ["gh", "repo", "view", f"{GITHUB_OWNER}/{name}"], check=False
    ).returncode == 0
    if exists:
        die(f"repo {GITHUB_OWNER}/{name} already exists on GitHub")
    print(f"  ok: gh authenticated; {GITHUB_OWNER}/{name} is available")


def aws_preflight(profile, name):
    ident = run(
        ["aws", "sts", "get-caller-identity", "--profile", profile,
         "--output", "json"], check=False)
    if ident.returncode != 0:
        die(f"AWS credentials for profile '{profile}' are not working:\n"
            f"{ident.stderr.strip()}")
    account = json.loads(ident.stdout)["Account"]

    org = run(["aws", "organizations", "describe-organization",
               "--profile", profile, "--output", "json"], check=False)
    if org.returncode != 0:
        die(f"profile '{profile}' cannot access AWS Organizations:\n"
            f"{org.stderr.strip()}")
    mgmt = json.loads(org.stdout)["Organization"]["MasterAccountId"]
    if account != mgmt:
        die(f"profile '{profile}' is account {account}, but the org "
            f"management account is {mgmt}; account creation must run "
            f"from the management account")

    root_id = run_json(
        ["aws", "organizations", "list-roots", "--profile", profile,
         "--output", "json"])["Roots"][0]["Id"]

    existing_ous = run_json(
        ["aws", "organizations", "list-organizational-units-for-parent",
         "--parent-id", root_id, "--profile", profile, "--output", "json"]
    )["OrganizationalUnits"]
    clash = next((ou for ou in existing_ous if ou["Name"] == name), None)
    if clash:
        die(f"an OU named '{name}' already exists under root ({clash['Id']})")

    mgmt_email = json.loads(org.stdout)["Organization"]["MasterAccountEmail"]
    print(f"  ok: management account {mgmt}, root {root_id}, "
          f"no OU named '{name}'")
    return root_id, mgmt_email


def config_preflight(name, envs):
    text = AWS_CONFIG_PATH.read_text() if AWS_CONFIG_PATH.exists() else ""
    for env in envs:
        pname = f"{name.lower()}-{env}"
        if re.search(rf"(?m)^\[profile {re.escape(pname)}\]", text):
            die(f"profile '{pname}' already exists in {AWS_CONFIG_PATH}")
    print(f"  ok: no profile name collisions in {AWS_CONFIG_PATH}")


def cdk_preflight(cwd, dry_run):
    """Returns (cdk_cmd, fresh) where fresh means cdk init will run."""
    check_binaries(["node", "npx"])
    if run(["which", "cdk"], check=False).returncode == 0:
        cdk_cmd = ["cdk"]
    else:
        cdk_cmd = ["npx", "-y", "aws-cdk"]
    fresh = not (cwd / "cdk.json").exists()
    if fresh:
        clutter = [p.name for p in cwd.iterdir()
                   if not p.name.startswith(".")]
        if clutter:
            msg = (f"'cdk init' needs an empty directory, but {cwd} "
                   f"contains: {', '.join(sorted(clutter)[:5])}")
            if dry_run:
                print(f"  warn: {msg}")
            else:
                die(msg)
        print(f"  ok: cdk available ({' '.join(cdk_cmd)}); will run cdk init")
    else:
        print("  ok: existing CDK app detected (cdk.json); will skip init")
    return cdk_cmd, fresh


def default_account_email(mgmt_email, name, env):
    """barbecuesteve@gmail.com -> barbecuesteve+name-env@gmail.com"""
    local, _, domain = mgmt_email.partition("@")
    local = local.split("+")[0]
    return f"{local}+{name}-{env}@{domain}"


# -------------------------------------------------------- generated files

def env_py(ids, envs, region):
    entries = "\n".join(
        f'    "{env}": {{"account": "{ids[env]}", "region": "{region}"}},'
        for env in envs)
    return f"""# Generated by awstool onboard on {time.strftime('%Y-%m-%d')}.
# Account and region pins for this project's deploy environments.
DEPLOY_ENVS = {{
{entries}
}}
"""


def oidc_py(repo):
    return f'''from aws_cdk import CfnOutput, Stack
from aws_cdk import aws_iam as iam
from constructs import Construct


class GithubOidcStack(Stack):
    """Lets GitHub Actions runs from {repo} deploy to this
    account by assuming the CDK bootstrap roles. Deployed once per
    account."""

    def __init__(self, scope: Construct, construct_id: str, **kwargs) -> None:
        super().__init__(scope, construct_id, **kwargs)

        provider = iam.OpenIdConnectProvider(
            self, "GithubOidc",
            url="https://token.actions.githubusercontent.com",
            client_ids=["sts.amazonaws.com"],
        )

        role = iam.Role(
            self, "DeployRole",
            role_name="GitHubDeployRole",
            assumed_by=iam.WebIdentityPrincipal(
                provider.open_id_connect_provider_arn,
                conditions={{
                    "StringEquals": {{
                        "token.actions.githubusercontent.com:aud":
                            "sts.amazonaws.com",
                    }},
                    "StringLike": {{
                        "token.actions.githubusercontent.com:sub":
                            "repo:{repo}:*",
                    }},
                }},
            ),
        )

        role.add_to_policy(iam.PolicyStatement(
            actions=["sts:AssumeRole"],
            resources=[f"arn:aws:iam::{{self.account}}:role/cdk-*"],
        ))

        CfnOutput(self, "DeployRoleArn", value=role.role_arn)
'''


def app_py(pkg, stack_module, stack_class, with_ci):
    oidc_import = (f"from {pkg}.github_oidc_stack import GithubOidcStack\n"
                   if with_ci else "")
    oidc_new = ('    GithubOidcStack(app, f"GithubOidc-{name}", env=env)\n'
                if with_ci else "")
    return f'''#!/usr/bin/env python3
import aws_cdk as cdk

from {pkg}.deploy_env import DEPLOY_ENVS
from {pkg}.{stack_module} import {stack_class}
{oidc_import}
app = cdk.App()
for name, target in DEPLOY_ENVS.items():
    env = cdk.Environment(account=target["account"],
                          region=target["region"])
    {stack_class}(app, f"{stack_class}-{{name}}", env=env)
{oidc_new}
app.synth()
'''


def env_ts(ids, envs, region):
    entries = "\n".join(
        f'  {env}: {{ account: "{ids[env]}", region: "{region}" }},'
        for env in envs)
    return f"""// Generated by awstool onboard on {time.strftime('%Y-%m-%d')}.
// Account and region pins for this project's deploy environments.
export interface DeployEnv {{
  account: string;
  region: string;
}}

export const envs: Record<string, DeployEnv> = {{
{entries}
}};
"""


def oidc_ts(repo):
    return f"""import * as cdk from 'aws-cdk-lib';
import * as iam from 'aws-cdk-lib/aws-iam';
import {{ Construct }} from 'constructs';

// Lets GitHub Actions runs from {repo} deploy to this account by
// assuming the CDK bootstrap roles. Deployed once per account.
export class GithubOidcStack extends cdk.Stack {{
  constructor(scope: Construct, id: string, props?: cdk.StackProps) {{
    super(scope, id, props);

    const provider = new iam.OpenIdConnectProvider(this, 'GithubOidc', {{
      url: 'https://token.actions.githubusercontent.com',
      clientIds: ['sts.amazonaws.com'],
    }});

    const role = new iam.Role(this, 'DeployRole', {{
      roleName: 'GitHubDeployRole',
      assumedBy: new iam.WebIdentityPrincipal(
        provider.openIdConnectProviderArn,
        {{
          StringEquals: {{
            'token.actions.githubusercontent.com:aud': 'sts.amazonaws.com',
          }},
          StringLike: {{
            'token.actions.githubusercontent.com:sub': 'repo:{repo}:*',
          }},
        }},
      ),
    }});

    role.addToPolicy(new iam.PolicyStatement({{
      actions: ['sts:AssumeRole'],
      resources: [`arn:aws:iam::${{this.account}}:role/cdk-*`],
    }}));

    new cdk.CfnOutput(this, 'DeployRoleArn', {{ value: role.roleArn }});
  }}
}}
"""


def bin_ts(stack_module, stack_class, with_ci):
    oidc_import = ("import { GithubOidcStack } "
                   "from '../lib/github-oidc-stack';\n") if with_ci else ""
    oidc_new = ("  new GithubOidcStack(app, `GithubOidc-${name}`, "
                "{ env });\n") if with_ci else ""
    return f"""#!/usr/bin/env node
import * as cdk from 'aws-cdk-lib';
import {{ envs }} from '../lib/env';
import {{ {stack_class} }} from '../lib/{stack_module}';
{oidc_import}
const app = new cdk.App();
for (const [name, env] of Object.entries(envs)) {{
  new {stack_class}(app, `{stack_class}-${{name}}`, {{ env }});
{oidc_new}}}
"""


def workflow_yml(ids, envs, region, stack_class, lang):
    if lang == "typescript":
        setup = """      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - run: npm ci
"""
        deploy = "npx cdk deploy"
    else:
        setup = """      - uses: actions/setup-node@v4
        with:
          node-version: 22
      - uses: actions/setup-python@v5
        with:
          python-version: '3.12'
      - run: npm install -g aws-cdk
      - run: python -m venv .venv && .venv/bin/pip install -r requirements.txt
"""
        deploy = "cdk deploy"

    def job(env, condition):
        return f"""  deploy-{env}:
    if: {condition}
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
{setup}      - uses: aws-actions/configure-aws-credentials@v4
        with:
          role-to-assume: arn:aws:iam::{ids[env]}:role/GitHubDeployRole
          aws-region: {region}
      - run: {deploy} '{stack_class}-{env}' --require-approval never
"""
    triggers = "  workflow_dispatch:\n"
    jobs = []
    if "staging" in envs:
        triggers = "  push:\n    branches: [main]\n" + triggers
        jobs.append(job("staging", "github.event_name == 'push'"))
    jobs.append(job("prod", "github.event_name == 'workflow_dispatch'"))
    return (f"name: deploy\n\non:\n{triggers}\n"
            f"permissions:\n  id-token: write\n  contents: read\n\n"
            f"jobs:\n" + "\n".join(jobs))


def detect_stack(cwd, lang):
    """Find the app stack cdk init generated: (pkg, module_stem, class)."""
    if lang == "typescript":
        for path in sorted((cwd / "lib").glob("*-stack.ts")):
            if path.name == "github-oidc-stack.ts":
                continue
            match = re.search(r"export class (\w+)", path.read_text())
            if match:
                return "lib", path.stem, match.group(1)
    else:
        for pkg_dir in sorted(p for p in cwd.iterdir() if p.is_dir()
                              and not p.name.startswith(".")
                              and p.name not in ("node_modules", "tests")):
            for path in sorted(pkg_dir.glob("*_stack.py")):
                if path.name == "github_oidc_stack.py":
                    continue
                match = re.search(r"class (\w+)\(.*Stack", path.read_text())
                if match:
                    return pkg_dir.name, path.stem, match.group(1)
    return None, None, None


# ------------------------------------------------------------------- steps

def do_repo(plan, name, cwd, visibility, description):
    if not (cwd / ".git").is_dir():
        plan.execute("Initialize local git repository",
                     cmd=["git", "init", str(cwd)])

    has_commit = (cwd / ".git").is_dir() and run(
        ["git", "-C", str(cwd), "rev-parse", "HEAD"], check=False
    ).returncode == 0
    if not has_commit:
        # README.md is guaranteed to exist by the docs step, which runs first
        plan.execute(
            "Create initial commit",
            fn=lambda: (
                run(["git", "-C", str(cwd), "add", "-A"]),
                run(["git", "-C", str(cwd), "commit", "-m",
                     "Initial commit"]),
            ),
            cmd=["git", "add", "-A", "&&", "git", "commit", "-m",
                 "Initial commit"])

    create_cmd = ["gh", "repo", "create", f"{GITHUB_OWNER}/{name}",
                  f"--{visibility}", "--source", str(cwd),
                  "--remote", "origin", "--push"]
    if description:
        create_cmd += ["--description", description]
    plan.execute(
        f"Create GitHub repo {GITHUB_OWNER}/{name} ({visibility}), "
        f"add remote 'origin', push", cmd=create_cmd)


def create_account_and_wait(plan, profile, account_name, email,
                            root_id, get_ou_id):
    """Create one member account, poll until done, move it into the OU."""
    create_cmd = ["aws", "organizations", "create-account",
                  "--profile", profile, "--output", "json",
                  "--email", email, "--account-name", account_name]

    def fn():
        status = run_json(create_cmd)["CreateAccountStatus"]
        req_id = status["Id"]
        deadline = time.time() + POLL_TIMEOUT_SECONDS
        while status["State"] == "IN_PROGRESS":
            if time.time() > deadline:
                die(f"timed out waiting for account '{account_name}' "
                    f"(request {req_id}); check with: aws organizations "
                    f"describe-create-account-status "
                    f"--create-account-request-id {req_id}")
            time.sleep(POLL_INTERVAL_SECONDS)
            status = run_json(
                ["aws", "organizations", "describe-create-account-status",
                 "--profile", profile, "--output", "json",
                 "--create-account-request-id", req_id]
            )["CreateAccountStatus"]
        if status["State"] != "SUCCEEDED":
            die(f"account creation failed: "
                f"{status.get('FailureReason', 'unknown reason')}")
        account_id = status["AccountId"]
        print(f"    created account {account_id}")
        run(["aws", "organizations", "move-account", "--profile", profile,
             "--account-id", account_id,
             "--source-parent-id", root_id,
             "--destination-parent-id", get_ou_id()])
        print(f"    moved {account_id} into OU {get_ou_id()}")
        return account_id

    return plan.execute(
        f"Create AWS account '{account_name}' ({email}), wait for "
        f"completion, move it into the project OU",
        cmd=create_cmd, fn=fn)


def do_aws(plan, profile, name, root_id, emails, envs, region):
    ou_id_holder = {}

    def create_ou():
        ou = run_json(
            ["aws", "organizations", "create-organizational-unit",
             "--profile", profile, "--output", "json",
             "--parent-id", root_id, "--name", name]
        )["OrganizationalUnit"]
        ou_id_holder["id"] = ou["Id"]
        print(f"    created OU {ou['Id']}")
        return ou

    plan.execute(
        f"Create OU '{name}' under root {root_id}",
        cmd=["aws", "organizations", "create-organizational-unit",
             "--profile", profile, "--parent-id", root_id, "--name", name],
        fn=create_ou)

    ids = {}
    for env in envs:
        account_id = create_account_and_wait(
            plan, profile, f"{name}-{env}", emails[env], root_id,
            get_ou_id=lambda: ou_id_holder.get("id", "<new-ou-id>"))
        ids[env] = account_id or f"<{env}-account-id>"

        pname = f"{name.lower()}-{env}"
        block = (f"\n[profile {pname}]\n"
                 f"role_arn = arn:aws:iam::{ids[env]}:role/"
                 f"OrganizationAccountAccessRole\n"
                 f"source_profile = {profile}\n"
                 f"region = {region}\n")
        plan.execute(
            f"Add profile '{pname}' to {AWS_CONFIG_PATH}",
            detail=block,
            fn=lambda b=block: AWS_CONFIG_PATH.open("a").write(b))
    return ids


def do_cdk(plan, cwd, name, ids, envs, region, lang, with_account, with_ci,
           cdk_cmd, fresh, holder):
    ts = lang == "typescript"
    if fresh:
        plan.execute(
            f"Initialize CDK {lang} app"
            + (" (also runs npm install)" if ts else ""),
            cmd=cdk_cmd + ["init", "app", "--language", lang])

    if not ts and fresh:
        plan.execute(
            "Create .venv and install CDK python dependencies",
            cmd=["sh", "-c", "python3 -m venv .venv && "
                 ".venv/bin/pip install -r requirements.txt"],
            fn=lambda: (run(["python3", "-m", "venv", ".venv"]),
                        run([".venv/bin/pip", "install", "-r",
                             "requirements.txt"])))

        def patch_cdk_json():
            path = cwd / "cdk.json"
            data = json.loads(path.read_text())
            data["app"] = ".venv/bin/python app.py"
            path.write_text(json.dumps(data, indent=2) + "\n")
            gitignore = cwd / ".gitignore"
            text = gitignore.read_text() if gitignore.exists() else ""
            if ".venv" not in text:
                gitignore.write_text(text + ".venv/\n")
        plan.execute(
            "Point cdk.json at .venv/bin/python so no venv activation "
            "is needed; ensure .venv is gitignored", fn=patch_cdk_json)

    # locate the stack cdk init generated (placeholders when dry-run
    # skipped the init that would have created it)
    pkg, module, klass = detect_stack(cwd, lang)
    if klass is None:
        if plan.dry_run:
            pkg, module, klass = "<package>", "<stack-module>", "<AppStack>"
        else:
            die("could not locate the generated app stack ("
                + ("lib/*-stack.ts" if ts else "*/*_stack.py") + ")")
    holder["stack_class"] = klass

    if with_account:
        env_path = (cwd / "lib" / "env.ts" if ts
                    else cwd / pkg / "deploy_env.py")
        if env_path.exists():
            print(f"    note: {env_path} exists; leaving it alone")
        else:
            content = (env_ts if ts else env_py)(ids, envs, region)
            plan.execute(
                f"Write {env_path} with account/region pins",
                detail=content,
                fn=lambda c=content: (env_path.parent.mkdir(exist_ok=True),
                                      env_path.write_text(c)))

    if with_ci:
        oidc_path = (cwd / "lib" / "github-oidc-stack.ts" if ts
                     else cwd / pkg / "github_oidc_stack.py")
        if oidc_path.exists():
            print(f"    note: {oidc_path} exists; leaving it alone")
        else:
            content = (oidc_ts if ts else oidc_py)(f"{GITHUB_OWNER}/{name}")
            plan.execute(
                f"Write {oidc_path} (OIDC provider + GitHubDeployRole)",
                detail=content,
                fn=lambda c=content: (oidc_path.parent.mkdir(exist_ok=True),
                                      oidc_path.write_text(c)))

    if fresh and with_account:
        if ts:
            content = bin_ts(module, klass, with_ci)

            def write_entry(c=content):
                files = sorted((cwd / "bin").glob("*.ts"))
                if not files:
                    die("could not find bin/*.ts after cdk init")
                files[0].write_text(c)
        else:
            content = app_py(pkg, module, klass, with_ci)

            def write_entry(c=content):
                (cwd / "app.py").write_text(c)

        plan.execute(
            f"Rewrite {'bin entrypoint' if ts else 'app.py'}: one "
            f"env-pinned stack per environment"
            + (" plus the OIDC stack" if with_ci else ""),
            detail=content, fn=write_entry)
    elif not fresh and with_account:
        print("    note: existing app; wire the generated env module"
              + (" and GithubOidcStack" if with_ci else "")
              + " into your app entrypoint yourself")

    if with_account:
        for env in envs:
            plan.execute(
                f"Bootstrap CDK in the {env} account",
                cmd=cdk_cmd + ["bootstrap", f"aws://{ids[env]}/{region}",
                               "--profile", f"{name.lower()}-{env}"])


def do_ci(plan, cwd, name, ids, envs, region, lang, cdk_cmd, fresh, holder):
    if fresh:
        for env in envs:
            plan.execute(
                f"Deploy GithubOidc-{env} (GitHub Actions deploy role)",
                cmd=cdk_cmd + ["deploy", f"GithubOidc-{env}",
                               "--profile", f"{name.lower()}-{env}",
                               "--require-approval", "never"])
    else:
        print("    note: once GithubOidcStack is wired into your app, "
              "deploy it per env: cdk deploy GithubOidc-<env> "
              "--profile <profile>")

    stack_class = holder.get("stack_class", "<AppStack>")
    wf_path = cwd / ".github" / "workflows" / "deploy.yml"
    content = workflow_yml(ids, envs, region, stack_class, lang)

    def fn():
        wf_path.parent.mkdir(parents=True, exist_ok=True)
        wf_path.write_text(content)

    plan.execute(f"Write {wf_path}", detail=content, fn=fn)


def do_docs(plan, name, cwd, sel, ids, envs, region, holder):
    lines = ["## Quick reference",
             "",
             f"Provisioned by awstool onboard on {time.strftime('%Y-%m-%d')}.",
             ""]
    if sel["account"]:
        for env in envs:
            lines.append(f"- {env}: AWS account {ids[env]}, "
                         f"CLI profile `{name.lower()}-{env}` "
                         f"(region {region})")
        lines += [
            f"- Verify access: `aws --profile {name.lower()}-prod "
            f"sts get-caller-identity`",
            f"- Open web console: `awsconsole {name}-prod` "
            f"(matches the Organizations account name)",
            f"- Accounts live in the '{name}' OU; org-level changes run "
            f"from the management account (profile `default`)",
        ]
    if sel["cdk"] and sel["account"]:
        stack = holder.get("stack_class", "<AppStack>")
        cdk_bin = "npx cdk" if sel["lang"] == "typescript" else "cdk"
        lines.append(f"- Deploy by hand: `{cdk_bin} deploy {stack}-staging "
                     f"--profile {name.lower()}-staging` (both accounts "
                     f"are already CDK-bootstrapped)")
    if sel["ci"]:
        lines += [
            "- CI: push to main deploys staging; deploy prod with "
            "`gh workflow run deploy.yml`",
            "- CI credentials: GitHub OIDC assuming `GitHubDeployRole` "
            "in each account (no stored keys)",
        ]
    if sel["repo"]:
        lines.append(f"- Repo: https://github.com/{GITHUB_OWNER}/{name} "
                     f"(`gh repo view {GITHUB_OWNER}/{name} --web`)")
    section = "\n".join(lines) + "\n"

    readme = cwd / "README.md"

    def fn():
        prefix = f"# {name}\n\n" if not readme.exists() else "\n"
        with readme.open("a") as f:
            f.write(prefix + section)

    plan.execute(f"Append quick-reference section to {readme}",
                 detail=section, fn=fn)


# -------------------------------------------------------------------- main

def cmd_onboard(args):
    cwd = Path.cwd()
    name = args.name or cwd.name
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]*", name):
        die(f"'{name}' is not usable as a repo/OU name; pass --name")

    interactive = not (args.with_repo or args.with_account
                       or args.with_staging_account or args.with_cdk
                       or args.with_ci)
    if interactive:
        print(f"Onboarding '{name}'. Choose what to set up:")
        args.with_repo = confirm("Create GitHub repo?")
        args.with_account = confirm("Create AWS OU + prod account?")
        if args.with_account:
            args.with_staging_account = confirm(
                "Also create a staging account?")
        args.with_cdk = confirm("Initialize a CDK app (TypeScript)?")
        if args.with_cdk and args.with_account and args.with_repo:
            args.with_ci = confirm(
                "Set up GitHub Actions deploys (OIDC roles + workflow)?")
        print()

    if args.with_staging_account:
        args.with_account = True
    if args.with_ci and not (args.with_repo and args.with_account
                             and args.with_cdk):
        die("--with-ci requires --with-repo, --with-account, and --with-cdk "
            "(the workflow needs a repo to trust and roles to assume)")
    if not (args.with_repo or args.with_account or args.with_cdk):
        die("nothing to do")

    mode = "DRY RUN" if args.dry_run else "EXECUTE"
    print(f"== awstool onboard: '{name}' ({mode}) ==\n")

    # ---- preflight (read-only, runs even in dry-run) ----
    print("Preflight checks:")
    binaries = (["git", "gh"] if args.with_repo else [])
    binaries += (["aws"] if args.with_account else [])
    check_binaries(binaries)
    if args.with_repo:
        gh_preflight(name)
    root_id = mgmt_email = None
    region = "us-west-2"
    envs = ["prod"] + (["staging"] if args.with_staging_account else [])
    if args.with_account:
        root_id, mgmt_email = aws_preflight(args.profile, name)
        config_preflight(name, envs)
        r = run(["aws", "configure", "get", "region",
                 "--profile", args.profile], check=False)
        region = r.stdout.strip() or "us-west-2"
    cdk_cmd = fresh = None
    if args.with_cdk:
        cdk_cmd, fresh = cdk_preflight(cwd, args.dry_run)

    # ---- gather inputs ----
    visibility = description = None
    emails = {}
    if args.with_repo:
        visibility = prompt("Repo visibility (public/private)",
                            default="private")
        if visibility not in ("public", "private"):
            die("visibility must be 'public' or 'private'")
        description = prompt("Repo description (optional)", default="")
    lang = None
    if args.with_cdk:
        lang = args.cdk_language or prompt(
            "CDK language (typescript/python)", default="typescript")
        lang = {"ts": "typescript", "py": "python"}.get(lang, lang)
        if lang not in ("typescript", "python"):
            die("CDK language must be 'typescript' or 'python'")
    if args.with_account:
        for env in envs:
            emails[env] = prompt(
                f"Email for the {env} account (must be unique across "
                f"all AWS accounts)",
                default=default_account_email(mgmt_email, name, env))

    # ---- build & run plan ----
    plan = Plan(dry_run=args.dry_run)
    print("\nPlanned changes:" if args.dry_run else "\nExecuting:")

    if args.with_account and not args.dry_run:
        print(f"\nAbout to create {len(envs)} AWS account(s): "
              + ", ".join(f"{name}-{e} <{emails[e]}>" for e in envs))
        print("Note: AWS accounts cannot be deleted, only closed, and "
              "closed accounts count against org quotas for 90 days.")
        if not confirm("Proceed with account creation?", args.yes):
            die("aborted")

    ids = {}
    holder = {}
    sel = {"repo": args.with_repo, "account": args.with_account,
           "cdk": args.with_cdk, "ci": args.with_ci, "lang": lang}
    if args.with_account:
        ids = do_aws(plan, args.profile, name, root_id, emails, envs, region)
    if args.with_cdk:
        do_cdk(plan, cwd, name, ids, envs, region, lang, args.with_account,
               args.with_ci, cdk_cmd, fresh, holder)
    if args.with_ci:
        do_ci(plan, cwd, name, ids, envs, region, lang, cdk_cmd, fresh,
              holder)
    do_docs(plan, name, cwd, sel, ids, envs, region, holder)
    if args.with_repo:
        do_repo(plan, name, cwd, visibility, description)

    print(f"\n{'Dry run complete; no changes made.' if args.dry_run else 'Done.'}")


def main():
    parser = argparse.ArgumentParser(prog="awstool")
    sub = parser.add_subparsers(dest="command", required=True)

    p = sub.add_parser(
        "onboard", help="stand up a new project",
        description="With no --with-* flags, prompts for each step.")
    p.add_argument("--with-repo", action="store_true",
                   help=f"create GitHub repo under '{GITHUB_OWNER}' and push")
    p.add_argument("--with-account", action="store_true",
                   help="create an Organizations OU, a prod account, and "
                        "a matching ~/.aws/config profile")
    p.add_argument("--with-staging-account", action="store_true",
                   help="also create a staging account (implies --with-account)")
    p.add_argument("--with-cdk", action="store_true",
                   help="cdk init, pin envs in a generated env module, "
                        "bootstrap accounts")
    p.add_argument("--cdk-language", metavar="LANG",
                   help="typescript or python (prompted if omitted)")
    p.add_argument("--with-ci", action="store_true",
                   help="GitHub OIDC deploy roles + deploy.yml workflow "
                        "(requires repo, account, and cdk)")
    p.add_argument("--name", help="project name (default: folder name)")
    p.add_argument("--profile", default="default",
                   help="AWS profile to use (default: default)")
    p.add_argument("--dry-run", action="store_true",
                   help="print planned changes without making them")
    p.add_argument("--yes", action="store_true",
                   help="skip confirmation prompts")
    p.set_defaults(func=cmd_onboard)

    args = parser.parse_args()
    try:
        args.func(args)
    except subprocess.CalledProcessError as e:
        die(f"command failed: {shell_repr(e.cmd)}\n{(e.stderr or '').strip()}")
    except KeyboardInterrupt:
        print()
        sys.exit(130)


if __name__ == "__main__":
    main()
